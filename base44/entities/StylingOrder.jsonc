{
  "name": "StylingOrder",
  "type": "object",
  "properties": {
    "height": {
      "type": "number",
      "description": "\u0627\u0644\u0637\u0648\u0644 \u0628\u0627\u0644\u0633\u0646\u062a\u064a\u0645\u062a\u0631"
    },
    "weight": {
      "type": "number",
      "description": "\u0627\u0644\u0648\u0632\u0646 \u0628\u0627\u0644\u0643\u062a\u0644\u0648\u062c\u0631\u0627\u0645"
    },
    "skin_tone": {
      "type": "string",
      "enum": [
        "\u0623\u0628\u064a\u0636",
        "\u0641\u0627\u062a\u062d",
        "\u062d\u0646\u0637\u064a",
        "\u0623\u0633\u0645\u0631",
        "\u063a\u0627\u0645\u0642"
      ],
      "description": "\u0644\u0648\u0646 \u0627\u0644\u0628\u0634\u0631\u0629"
    },
    "gender": {
      "type": "string",
      "enum": [
        "\u0630\u0643\u0631",
        "\u0623\u0646\u062b\u0649"
      ]
    },
    "season": {
      "type": "string",
      "enum": [
        "\u0631\u0628\u064a\u0639",
        "\u0635\u064a\u0641",
        "\u062e\u0631\u064a\u0641",
        "\u0634\u062a\u0627\u0621"
      ]
    },
    "style": {
      "type": "string"
    },
    "occasion": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed"
      ],
      "default": "pending",
      "rls": {
        "read": true,
        "write": false
      }
    },
    "credited": {
      "type": "boolean",
      "default": false,
      "description": "\u0631\u0635\u064a\u062f \u0645\u0645\u0646\u0648\u062d \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0646\u062a\u064a\u062c\u0629 \u0641\u0634\u0644 \u0627\u0644\u062a\u0648\u0644\u064a\u062f \u064a\u0645\u0643\u0646\u0647 \u0645\u0646 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u062c\u062f\u062f\u0627\u064b \u0628\u062f\u0648\u0646 \u062f\u0641\u0639",
      "rls": {
        "read": true,
        "write": false
      }
    },
    "credit_spent": {
      "type": "boolean",
      "default": false,
      "description": "Whether one credit was already deducted for this order at create/unlock time",
      "rls": {
        "read": true,
        "write": false
      }
    },
    "iap_platform": {
      "type": "string",
      "enum": [
        "apple",
        "google"
      ],
      "description": "Deprecated — purchases are verified only via RevenueCat webhook. Kept for legacy rows.",
      "rls": {
        "read": false,
        "write": false
      }
    },
    "iap_receipt": {
      "type": "string",
      "description": "Deprecated — never accept client-supplied receipts as payment proof.",
      "rls": {
        "read": false,
        "write": false
      }
    },
    "outfits": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "height",
    "weight",
    "gender",
    "season",
    "style",
    "occasion"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
