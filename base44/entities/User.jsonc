{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ],
      "rls": {
        "read": true,
        "write": false
      }
    },
    "height": {
      "type": "number",
      "description": "\u0627\u0644\u0637\u0648\u0644 \u0628\u0627\u0644\u0633\u0646\u062a\u064a\u0645\u062a\u0631"
    },
    "weight": {
      "type": "number",
      "description": "\u0627\u0644\u0648\u0632\u0646 \u0628\u0627\u0644\u0643\u064a\u0644\u0648\u062c\u0631\u0627\u0645"
    },
    "gender": {
      "type": "string",
      "enum": [
        "\u0630\u0643\u0631",
        "\u0623\u0646\u062b\u0649"
      ]
    },
    "skin_tone": {
      "type": "string",
      "enum": [
        "\u0623\u0628\u064a\u0636",
        "\u0641\u0627\u062a\u062d",
        "\u062d\u0646\u0637\u064a",
        "\u0623\u0633\u0645\u0631",
        "\u063a\u0627\u0645\u0642"
      ],
      "description": "\u0644\u0648\u0646 \u0627\u0644\u0628\u0634\u0631\u0629"
    },
    "default_season": {
      "type": "string"
    },
    "default_style": {
      "type": "string"
    },
    "credits": {
      "type": "number",
      "default": 0,
      "description": "\u0631\u0635\u064a\u062f \u0627\u0644\u0625\u0637\u0644\u0627\u0644\u0627\u062a \u0627\u0644\u0645\u062a\u0628\u0642\u0651\u064a (\u062d\u0632\u0645\u0629 \u0643\u0631\u064a\u062f\u064a\u062a \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0627\u0633\u062a\u0647\u0644\u0627\u0643). Server-only: granted by revenuecat-webhook, spent by create-order/unlock-generation.",
      "rls": {
        "read": true,
        "write": false
      }
    },
    "rc_processed_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "RevenueCat webhook event IDs already credited (idempotency)",
      "rls": {
        "read": false,
        "write": false
      }
    },
    "is_pro": {
      "type": "boolean",
      "default": false,
      "description": "\u064a\u0644\u062a \u062a\u0641\u0639\u064a\u0644 Pro \u0639\u0628\u0631 RevenueCat (Entitlement styliq_pro). Server-only.",
      "rls": {
        "read": true,
        "write": false
      }
    },
    "rc_processed_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "RevenueCat transaction/event IDs already credited — prevents duplicate +5 on webhook retries",
      "rls": {
        "read": false,
        "write": false
      }
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}
