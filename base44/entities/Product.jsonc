{
  "name": "Product",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0646\u062a\u062c \u0627\u0644\u0641\u0631\u064a\u062f \u0645\u0646 \u0627\u0644\u0643\u062a\u0627\u0644\u0648\u062c/\u0645\u0632\u0648\u0651\u062f \u0627\u0644\u0640 affiliate"
    },
    "brand": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0627\u0631\u0643\u0629 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629"
    },
    "product_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u062a\u062c \u0627\u0644\u062d\u0642\u064a\u0642\u064a"
    },
    "category": {
      "type": "string",
      "description": "\u0627\u0644\u0641\u0626\u0629: top / bottom / shoes / accessory / outerwear / dress"
    },
    "subcategory": {
      "type": "string",
      "description": "\u0627\u0644\u0641\u0626\u0629 \u0627\u0644\u0641\u0631\u0639\u064a\u0629 (\u0645\u062b\u0644 t-shirt / jeans / sneakers)"
    },
    "gender": {
      "type": "string",
      "enum": [
        "\u0630\u0643\u0631",
        "\u0623\u0646\u062b\u0649",
        "unisex"
      ]
    },
    "color": {
      "type": "string"
    },
    "season": {
      "type": "string",
      "enum": [
        "\u0631\u0628\u064a\u0639",
        "\u0635\u064a\u0641",
        "\u062e\u0631\u064a\u0641",
        "\u0634\u062a\u0627\u0621",
        "all"
      ]
    },
    "occasion": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 (\u0643\u0627\u062c\u0648\u0627\u0644/\u0631\u0633\u0645\u064a/\u0631\u064a\u0627\u0636\u064a...)"
    },
    "style": {
      "type": "string",
      "description": "\u0627\u0644\u0633\u062a\u0627\u064a\u0644 (\u0643\u0627\u062c\u0648\u0627\u0644/\u0631\u0633\u0645\u064a/\u0645\u064a\u0646\u064a\u0645\u0627\u0644...)"
    },
    "price": {
      "type": "number",
      "description": "\u0627\u0644\u0633\u0639\u0631"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "\u0631\u0645\u0632 \u0627\u0644\u0639\u0645\u0644\u0629"
    },
    "image_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0646\u062a\u062c \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629"
    },
    "product_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u0646\u062a\u062c \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629 \u0639\u0646\u062f \u0627\u0644\u0645\u062a\u062c\u0631"
    },
    "availability_status": {
      "type": "string",
      "enum": [
        "in_stock",
        "out_of_stock",
        "low_stock"
      ],
      "default": "in_stock"
    }
  },
  "required": [
    "product_id",
    "brand",
    "product_name",
    "category",
    "gender",
    "price",
    "currency",
    "image_url",
    "product_url",
    "availability_status"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}